# Server-side secrets only. Never expose these values in public JavaScript.
GOOGLE_API_KEY=replace_with_a_google_ai_studio_key

# Gemini Live voice assistant preview.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Sadaltager

# Existing text chatbot configuration.
GEMINI_CHAT_MODEL=gemini-2.5-flash
OPENAI_CHAT_MODEL=gpt-5.5
